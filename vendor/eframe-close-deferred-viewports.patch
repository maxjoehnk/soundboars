+/// SoundBoars patch: lets a deferred viewport close its own window, instead of waiting for its
+/// parent's next pass (which may never come while the parent's window is hidden on Wayland).
+///
+/// After the pass of `viewport_id`: its own closed children are up to it again; if the pass ended
+/// with a close request (a [`egui::ViewportCommand::Close`] for itself, or the user closing the
+/// window without [`egui::ViewportCommand::CancelClose`]), it is closed. Closed viewports are
+/// removed from `viewport_output`, so the caller prunes their window.
+fn forget_closed_viewports(
+    closed_viewports: &mut HashMap<ViewportId, ViewportId>,
+    viewports: &Viewports,
+    viewport_id: ViewportId,
+    close_requested: bool,
+    viewport_output: &mut OrderedViewportIdMap<egui::ViewportOutput>,
+) {
+    closed_viewports.retain(|_, parent| *parent != viewport_id);
+    let commands = viewport_output
+        .get(&viewport_id)
+        .map(|output| output.commands.as_slice())
+        .unwrap_or_default();
+    let closes = commands.contains(&egui::ViewportCommand::Close)
+        || (close_requested && !commands.contains(&egui::ViewportCommand::CancelClose));
+    if viewport_id != ViewportId::ROOT
+        && closes
+        && let Some(viewport) = viewports.get(&viewport_id)
+    {
+        log::debug!("Viewport {viewport_id:?} closed itself");
+        closed_viewports.insert(viewport_id, viewport.ids.parent);
+    }
+    viewport_output.retain(|id, _| !closed_viewports.contains_key(id));
+}
